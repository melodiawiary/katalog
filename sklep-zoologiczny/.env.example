# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://twojprojekt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=wklej-tu-klucz-anon-public

# Nazwa sklepu tylko na czas przed uzupełnieniem ustawień w panelu (/admin/ustawienia).
# Dane firmy, numer konta i kontakt wpisuje się w panelu, nie tutaj.
NEXT_PUBLIC_SHOP_NAME=Sklep Zoologiczny

# TYLKO na serwerze (bez NEXT_PUBLIC_!). Supabase -> Project Settings -> API Keys -> secret (albo legacy service_role).
# Potrzebny do: e-maili z potwierdzeniem zamówienia, płatności Przelewy24, automatu "Produkt znów dostępny".
SUPABASE_SERVICE_ROLE_KEY=wklej-tu-klucz-secret

# Nieobowiązkowe: zabezpieczenie codziennego automatu /api/cron (Vercel dodaje nagłówek sam)
# CRON_SECRET=dowolny-dlugi-ciag-znakow
